{
  "name": "dsh-temperature",
  "version": "0.1.0",
  "description": "Temperature control for DeepSeek Harness: a global default and per-session overrides, injected into every agent LLM request via the agent/request waterfall.",
  "type": "module",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "temperature",
    "sampling",
    "llm"
  ],
  "files": [
    "lib/index.js",
    "src/index.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.0",
    "@deepseek-ai/schemastery": ">=0.0.0"
  },
  "license": "MIT"
}
